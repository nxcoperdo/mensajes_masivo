# WhatsApp Business Cloud API (Meta) — SOLO se usan como semilla del
# primer cliente (Code Repair Tech) la primera vez que arranca la app
# con la base de datos vacía. Cada cliente nuevo conecta su propio
# WhatsApp Business con el botón "Conectar WhatsApp" (Embedded Signup),
# y sus credenciales quedan guardadas en la tabla `clientes`, no acá.
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_WABA_ID=tu_whatsapp_business_account_id
WHATSAPP_API_TOKEN=tu_access_token
WHATSAPP_API_VERSION=v20.0
WHATSAPP_LANGUAGE_CODE=es

# Email con el que queda sembrado el primer cliente (Code Repair Tech)
# si la base de datos está vacía al arrancar. Su contraseña es
# BASIC_AUTH_PASS si está definida, o una generada al azar que se
# imprime una sola vez en el log al arrancar.
SEED_ADMIN_EMAIL=admin@tudominio.com

# Clave para firmar la cookie de sesión (login por cliente). Cualquier
# string largo y aleatorio — cambiarlo invalida todas las sesiones
# activas.
SESSION_SECRET=elegí_un_string_largo_y_aleatorio

# App de Meta (Settings > Basic) — necesaria para el flujo de Embedded
# Signup con el que cada cliente conecta su propio WhatsApp Business.
# FACEBOOK_APP_ID es público (va en el HTML). FACEBOOK_APP_SECRET es
# server-side, para intercambiar el "code" que devuelve el popup por un
# access token. FACEBOOK_EMBEDDED_CONFIG_ID se crea en WhatsApp >
# Configuration > Embedded Signup dentro del App Dashboard.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_EMBEDDED_CONFIG_ID=

# Webhook (Meta > tu app > WhatsApp > Configuration > Webhook), para
# recibir confirmaciones de estado (enviado/entregado/leído) y
# mensajes entrantes (respuestas de la gente) en /webhook.
# - WHATSAPP_VERIFY_TOKEN: cualquier string que vos elijas — hay que
#   poner el mismo valor en el campo "Verify token" de Meta.
# - WHATSAPP_APP_SECRET: "App secret" de tu app de Meta (Settings >
#   Basic). Si lo completás, se valida la firma de cada request entrante
#   al webhook; si lo dejás vacío, no se valida (solo para dev local).
WHATSAPP_VERIFY_TOKEN=elegí_un_token_secreto
WHATSAPP_APP_SECRET=

# Puerto donde corre esta app
PORT=4100

# Milisegundos de espera entre cada mensaje de una campaña, para no
# pegarle a la API de Meta muy rápido. 250ms = ~4 mensajes/segundo,
# de sobra conservador para cualquier tier de WhatsApp Business.
ENVIO_DELAY_MS=250

# Login HTTP Basic para toda la app. Si dejás estas dos vacías, no pide
# login (solo recomendable en local). En el VPS, definilas siempre.
# Si la contraseña tiene '#', va entre comillas (si no, dotenv la corta
# ahí pensando que es un comentario).
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS="cambiame"

# Prospección de leads B2B (búsqueda de negocios por categoría/ciudad)
#
# Si tenés una API key de Google Places, ponela acá y se usa Text
# Search + Place Details (resultados más completos, de pago pasado el
# free tier de Google — necesita facturación habilitada en Google
# Cloud aunque no la gastes). Si la dejás vacía, la app usa
# automáticamente Nominatim + Overpass (OpenStreetMap), gratis y sin
# necesidad de key.
GOOGLE_PLACES_API_KEY=

# Nominatim (geocodificación OSM, se usa solo si no hay Google key)
# exige un User-Agent descriptivo en cada request, no uno genérico —
# poné el nombre de tu app y un contacto, ej:
# "mi-negocio-leads/1.0 (contacto@midominio.com)"
NOMINATIM_USER_AGENT=whatsapp-broadcast-leads/1.0

# Radio de búsqueda (metros) alrededor del centro de la ciudad, y tope
# de resultados por búsqueda (aplica a ambos proveedores)
LEADS_RADIO_METROS=5000
LEADS_MAX_RESULTADOS=20
